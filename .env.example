# Google Gemini API Key (Obrigatório - Exclusivo Gemini 3.7 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Provedor do Banco Vetorial (ChromaDB / Local)
VECTOR_DB_PROVIDER=ChromaDB
CHROMA_SERVER_URL=http://localhost:8000

# Porta e Ambiente do Next.js
PORT=3000
NODE_ENV=development

# Configuração do Banco de Dados Relacional SQLite
DATABASE_PATH=./data/ebook_generator.db
